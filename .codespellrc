[codespell]
# British spellings are house style; crate/tech names are not typos.
ignore-words-list = crate,statics,unparseable,ser,de,deser,serde,noyalib,dtt,metatags,metatag,toml,behaviour,behavioural,colour,favour,initialise,serialise,serialiser,serialisation,deserialise,deserialiser,deserialisation,normalise,normalised,standardise,standardised,ot,fallin,wit
skip = ./target,./supply-chain/imports.lock,./Cargo.lock,./examples/deploy/cloudflare-workers/package-lock.json,./fuzz/target,./wasi/target,./examples/deploy/http-handler/target,./examples/deploy/http-handler/Cargo.lock,./examples/deploy/spin/.spin,./examples/deploy/wasmcloud/build,./fuzz/corpus,./fuzz/artifacts,./.git
