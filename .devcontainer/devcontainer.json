{
  "name": "metadata-gen",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "postCreateCommand": "rustup component add rustfmt clippy",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "DavidAnson.vscode-markdownlint"
      ]
    }
  }
}
